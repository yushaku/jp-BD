# MySQL
MYSQL_DATABASE=wordpress
MYSQL_USER=wp
MYSQL_PASSWORD=wp_secret_change_me
MYSQL_ROOT_PASSWORD=root_secret_change_me

# WordPress site (public URL — synced by scripts/mode.sh)
WORDPRESS_URL=http://localhost

# Headless Next.js frontend (public URLs — synced by scripts/mode.sh)
NEXT_PUBLIC_SITE_URL=http://localhost
NEXT_PUBLIC_WP_URL=http://localhost
WORDPRESS_API_URL=http://wordpress:80

# Dev mode: local | ports | tunnel (see scripts/mode.sh)
SOS_MODE=local
TUNNEL_HOSTNAME=shop.yuchi-education.com

# Nginx reverse proxy (used by local + tunnel modes)
NGINX_HTTP_PORT=80

# Admin (used by setup.sh on first run)
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin123_change_me
WP_ADMIN_EMAIL=admin@example.com
WP_SITE_TITLE=JP Bùi Đặng

# VNPay sandbox (configure in WooCommerce > Settings > Payments after setup)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# MoMo sandbox (configure in WooCommerce > Settings > Payments after setup)
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create

# WooCommerce REST API keys — run setup.sh to auto-generate
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=
